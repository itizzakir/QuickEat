# QuickBite frontend configuration.
# Copy to .env and adjust. Only variables prefixed with VITE_ are visible to the app;
# anything without that prefix is silently ignored by Vite.
#
# WARNING: everything in this file is bundled into the client and is therefore PUBLIC.
# Never put API keys, tokens or passwords here — put them behind the backend instead.

# Base URL of the Spring Boot backend. Used as the target of the Vite dev-server proxy
# (see vite.config.js), which forwards /api/* to the backend.
VITE_API_BASE_URL=http://localhost:8080
