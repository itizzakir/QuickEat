# QuickBite backend configuration.
# Copy to .env (or export these in your shell / container environment) and fill in real values.
# Every variable below has a development default in application.properties; override all of
# them in any deployed environment.

# --- Database -----------------------------------------------------------------
# JDBC URL for the MySQL instance. createDatabaseIfNotExist=true lets the app create the schema.
DB_URL=jdbc:mysql://localhost:3306/food_delivery_db?createDatabaseIfNotExist=true
DB_USERNAME=root
DB_PASSWORD=change-me

# --- JWT ----------------------------------------------------------------------
# MUST be valid Base64 — JwtUtils decodes it with Decoders.BASE64 before building the HMAC key.
# Generate one with:  openssl rand -base64 64
JWT_SECRET=replace-with-a-base64-encoded-64-byte-secret
# Token lifetime in milliseconds (86400000 = 24 hours).
JWT_EXPIRATION_MS=86400000

# --- Seed data ----------------------------------------------------------------
# Set to false to start the app without inserting demo restaurants, menus and accounts.
SEED_ENABLED=true

# --- CORS ---------------------------------------------------------------------
# Comma-separated browser origins allowed to call the API. No wildcards: the API is
# configured to allow credentials, which forbids "*".
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
