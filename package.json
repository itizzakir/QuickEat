{
  "name": "quickbite",
  "version": "1.0.0",
  "private": true,
  "description": "QuickBite food delivery \u2014 Spring Boot API + React client",
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "dev:backend": "node scripts/mvnw.mjs spring-boot:run",
    "dev:frontend": "cd food-delivery-frontend && npm run dev",
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:backend\" \"npm:dev:frontend\"",
    "build:backend": "node scripts/mvnw.mjs clean package",
    "build:frontend": "cd food-delivery-frontend && npm ci && npm run build",
    "test:backend": "node scripts/mvnw.mjs test",
    "test:frontend": "cd food-delivery-frontend && npm test",
    "lint": "cd food-delivery-frontend && npm run lint"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=18"
  }
}
