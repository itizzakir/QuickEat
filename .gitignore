# Root workspace — the per-module .gitignore files cover the backend and frontend.

# `npm install` at the root installs `concurrently` for the combined dev script.
/node_modules/

# Local environment overrides
.env
.env.*
!.env.example

# JVM crash dumps
hs_err_pid*.log
replay_pid*.log

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
